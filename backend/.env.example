# VLM 精查二选一（或只配你用的那家）
# VLM_PROVIDER=ark
# ARK_API_KEY=your_api_key_here
# ARK_MODEL_ID=your_model_id_here
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# VLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# VLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=sk-...
# QWEN_MODEL=qwen-vl-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 或百炼工作空间域名：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

DISABLE_FAISS=1

# 品种分类 MobileNet / EfficientNet（架构图 Stage 0）
# VARIETY_ENABLED=1
# VARIETY_MODEL_PATH=models/screw_variety_mobilenet.pt
# VARIETY_BACKBONE=mobilenet_v3_small
# VARIETY_STRATEGIES_PATH=app/assets/variety_sort_strategies.json

# 可选：YOLOv8 粗筛权重（训练自 screw-dataset）
YOLO_MODEL_PATH=models/screw_yolov8.pt
# YOLO_RECALL_THRESHOLD=0.15
# YOLO_VLM_TRIGGER_THRESHOLD=0.5
# VLM_TIMEOUT_SECONDS=3

# 6D 位姿 — 路径1 YOLO-Pose+PnP / 路径2 TinyDETR-Pose（auto 按序尝试）
# POSE_ENABLED=1
# POSE_MODE=auto
# YOLO_POSE_MODEL_PATH=models/screw_yolov8_pose.pt
# TINYDETR_POSE_MODEL_PATH=models/screw_tinydetr_pose.pt
# POSE_CONTOUR_FALLBACK=0
# CAMERA_INTRINSICS_PATH=app/assets/default_camera_intrinsics.json
# HAND_EYE_MATRIX_PATH=app/assets/hand_eye_identity.json
# SCREW_MODEL_3D_PATH=app/assets/screw_keypoints_3d.json
