# 复制为 screw_algo/.env 并按需修改（勿提交密钥）

# 课件默认：Qwen2.5-VL 精查（画框图 + 固定 Prompt 模板 + JSON Schema）
VLM_PROVIDER=qwen
QWEN_API_KEY=
# 亦可用 DASHSCOPE_API_KEY=  （与 QWEN_API_KEY 等价）
QWEN_MODEL=qwen2.5-vl-72b-instruct
# 可选轻量：qwen2.5-vl-7b-instruct / qwen-vl-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_PROMPT_PATH=assets/vlm_screw_inspect_prompt.txt
# 备选 DeepSeek（非课件默认）：VLM_PROVIDER=deepseek + DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 品种分类 MobileNet / EfficientNet（架构图 Stage 0）
VARIETY_ENABLED=1
VARIETY_MODEL_PATH=models/screw_variety_mobilenet.pt
VARIETY_BACKBONE=mobilenet_v3_small
VARIETY_MIN_CONFIDENCE=0.35
VARIETY_STRATEGIES_PATH=assets/variety_sort_strategies.json

# 权重与标定（相对 screw_algo/ 目录，默认已指向 models/ 与 assets/）
YOLO_MODEL_PATH=models/screw_yolov8.pt
YOLO_COARSE_TASK=auto
YOLO_OBB_MODEL_PATH=models/screw_yolov8_obb.pt
VARIETY_YOLO_MODELS_PATH=assets/variety_yolo_models.json
VARIETY_PENDING_CLASS_ID=variety_pending
VLM_DRAW_YOLO_BOXES=1
VLM_JSON_SCHEMA_VALIDATE=1
VLM_TIMEOUT_SECONDS=3
YOLO_POSE_MODEL_PATH=models/screw_yolov8_pose.pt
TINYDETR_POSE_MODEL_PATH=models/screw_tinydetr_pose.pt
CAMERA_INTRINSICS_PATH=assets/default_camera_intrinsics.json
SCREW_MODEL_3D_PATH=assets/screw_keypoints_3d.json
HAND_EYE_MATRIX_PATH=assets/hand_eye_identity.json

POSE_MODE=auto
POSE_CONTOUR_FALLBACK=1
